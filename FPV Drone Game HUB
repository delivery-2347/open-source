local Tab = Window:NewTab("fpv control")

local Section = Tab:NewSection("by CUCUMBER")
do
    local speed
    Section:NewKeybind("acceleration ", "67", Enum.KeyCode.X, function()
        local objflod = localPlayer.Name .. "_FPVDrone"
        local obj = workspace:FindFirstChild(objflod).CameraPoint
        obj.AssemblyLinearVelocity = obj.CFrame.LookVector * speed
    end)
    local SpeedSlider = Section:NewSlider("Скорость", "Значение от 0 до 100", 500, 0, function(value)
        speed = value
    end)
    SpeedSlider:SetValue(500)
end

do
    local neim_hub = "FPV Drone Game HUB"
    ril_nem = nil
    repeat
        for _, obj in ipairs(game:GetService("CoreGui"):GetDescendants()) do
            if obj:IsA("TextLabel") and obj.Text:find(neim_hub, 1, true) then
                local parent = obj.Parent

                while parent and parent ~= game:GetService("CoreGui") do
                    if parent:IsA("ScreenGui") then
                        ril_nem = parent
                        print("GUI найден:", ril_nem:GetFullName())
                        break
                    end

                    parent = parent.Parent
                end

                if ril_nem then
                    break
                end
            end
        end
        if not ril_nem then
            task.wait(0.05)
        end
    until ril_nem
    local watchedGui = ril_nem
    local destroyed = false
    local function OnGuiDestroyed()
        if destroyed then return end
        destroyed = true
        if ril_nem == watchedGui then
            ril_nem = nil
        end
        ENEIBLE = false
        for _, toggle in pairs(toggleall) do
            pcall(function()
                toggle:UpdateToggle(
                    "If you see this message, your GUI is frozen. Reboot it.",
                    false
                )
            end)
        end
        print("da blina 😭😭😭😭😭😭")
    end
    watchedGui.Destroying:Connect(OnGuiDestroyed)
    watchedGui.AncestryChanged:Connect(function(_, parent)
        if parent == nil then
            OnGuiDestroyed()
        end
    end)
end
