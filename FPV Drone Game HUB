local Window = Kavo.CreateLib("FPV Drone Game HUB", CUCUMBER)

local Tab = Window:NewTab("mein")

local Section = Tab:NewSection("by CUCUMBER")

do
    function get_drun()
        local playerGui = game:GetService("Players").LocalPlayer.PlayerGui
        local droneGui = playerGui:FindFirstChild("DroneGui")
        local drun = droneGui.FPVHotbar.FPVSlot.ItemName.Text
        local skok = string.match(drun, "(%d+)/%d+")
        return tonumber(skok) or 0
    end

    toggleall.auto_get_fpv = Section:NewToggle("auto get fpv", "Включает или выключает режим", function(state)
        while state do 
            task.wait(0)
            for _, obj in ipairs(workspace["\209\133\209\131\208\185\208\189\209\143 \208\186\208\176\208\186\208\176\209\143-\209\130\208\190"]:GetDescendants()) do
                if get_drun() == 2 then task.wait(0.1) continue  end
                if obj.Name == "DroneBox" and obj:FindFirstChildOfClass("ClickDetector") then
                    fireclickdetector(obj.ClickDetector)
                end
            end
        end
    end)

    Section:NewKeybind("auto get fpv", "Нажми, чтобы назначить кнопку", Enum.KeyCode.G, function()
        for _, obj in ipairs(workspace["\209\133\209\131\208\185\208\189\209\143 \208\186\208\176\208\186\208\176\209\143-\209\130\208\190"]:GetDescendants()) do
            if get_drun() == 2 then return end
            if obj.Name == "DroneBox" and obj:FindFirstChildOfClass("ClickDetector") then
                fireclickdetector(obj.ClickDetector)
            end
        end
    end)
end

