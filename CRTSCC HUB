    }

    local CustomEnabled, NotificationId = false, 0
    local OldGui, OldMain, OldGuiEnabled, OldMainDisabled
    local ProtectionConnections = {}
    local GuiAddedConnection, RewardConnection

    local function Disconnect(Connection)
        if Connection then Connection:Disconnect() end
    end

    local function ClearProtection()
        for _, Connection in ipairs(ProtectionConnections) do
            Disconnect(Connection)
        end
        table.clear(ProtectionConnections)
    end

    local function FindMain(Gui)
        local Frame1 = Gui:FindFirstChild("Frame")
        local Frame2 = Frame1 and Frame1:FindFirstChild("Frame")
        local Main = Frame2 and Frame2:FindFirstChild("Main")
        return Main and Main:IsA("LocalScript") and Main or nil
    end

    local function ProtectMain(Main)
        if not Main or not Main:IsA("LocalScript") then return end
        if OldMain == Main then
            Main.Disabled = true
            return
        end

        OldMain, OldMainDisabled = Main, Main.Disabled
        table.insert(ProtectionConnections, Main:GetPropertyChangedSignal("Disabled"):Connect(function()
            if CustomEnabled and not Main.Disabled then Main.Disabled = true end
        end))
        Main.Disabled = true
    end

    local function ProtectOldGui(Gui)
        if not CustomEnabled or not Gui then return end

        if OldGui ~= Gui then
            ClearProtection()
            OldGui, OldGuiEnabled = Gui, Gui.Enabled
            OldMain, OldMainDisabled = nil, nil

            table.insert(ProtectionConnections, Gui:GetPropertyChangedSignal("Enabled"):Connect(function()
                if CustomEnabled and Gui.Enabled then Gui.Enabled = false end
            end))

            table.insert(ProtectionConnections, Gui.DescendantAdded:Connect(function(Object)
                if not CustomEnabled or Object.Name ~= "Main" or not Object:IsA("LocalScript") then return end
                task.defer(function()
                    if CustomEnabled and Object.Parent then
                        local FoundMain = FindMain(Gui)
                        if FoundMain then ProtectMain(FoundMain) end
                    end
                end)
            end))
        end

        local Main = FindMain(Gui)
        if Main then ProtectMain(Main) end
        if OldMain then OldMain.Disabled = true end
        Gui.Enabled = false
    end

