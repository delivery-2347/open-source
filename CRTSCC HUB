        local CurrentId = NotificationId
        Frame.Visible = true

        task.delay(NOTIFICATION_TIME, function()
            if NotificationId == CurrentId and Frame.Parent then Frame.Visible = false end
        end)
    end

	local function RestoreOriginalGui()
	    local Main, OriginalGui = OldMain, OldGui

	    if Main and Main.Parent then
	        local RootFrame = Main.Parent

	        while RootFrame.Parent and RootFrame.Parent:IsA("GuiObject") do
	            RootFrame = RootFrame.Parent
	        end

	        if RootFrame:IsA("GuiObject") then
	            local Position = RootFrame.Position
	            RootFrame.Position = UDim2.new(Position.X.Scale, Position.X.Offset, -10000, 0)
	        end

	        Main.Disabled = OldMainDisabled
	    end

	    if OriginalGui and OriginalGui.Parent then
	        OriginalGui.Enabled = OldGuiEnabled
	    end

	    OldMain, OldGui = nil, nil
	    OldMainDisabled, OldGuiEnabled = nil, nil
	end

    local function CustomMenu(State)
        CustomEnabled = State == true

        if CustomEnabled then
            Gui.Enabled = true
            local OriginalGui = PlayerGui:FindFirstChild("StochasticRemunerationGUI")
            if OriginalGui then ProtectOldGui(OriginalGui) end

            Disconnect(GuiAddedConnection)
            GuiAddedConnection = PlayerGui.ChildAdded:Connect(function(Child)
                if not CustomEnabled or Child.Name ~= "StochasticRemunerationGUI" then return end
                task.defer(function()
                    if CustomEnabled and Child.Parent == PlayerGui then ProtectOldGui(Child) end
                end)
            end)

            if not RewardConnection then
                RewardConnection = RewardEvent.OnClientEvent:Connect(Notify)
            end
        else
            NotificationId += 1
            Frame.Visible, Gui.Enabled = false, false

            Disconnect(RewardConnection)
            Disconnect(GuiAddedConnection)
            RewardConnection, GuiAddedConnection = nil, nil
            ClearProtection()
            RestoreOriginalGui()
        end
    end

    local Environment = _G
    if type(getgenv) == "function" then
        local Success, Result = pcall(getgenv)
        if Success and type(Result) == "table" then Environment = Result end
