	local ItemName = Instance.new("TextLabel")
	ItemName.Position = UDim2.fromOffset(16, 27)
	ItemName.Size = UDim2.new(1, -25, 0, 23)
	ItemName.BackgroundTransparency = 1
	ItemName.Font = Enum.Font.GothamBold
	ItemName.TextSize = 15
	ItemName.TextColor3 = Color3.fromRGB(240, 240, 245)
	ItemName.TextXAlignment = Enum.TextXAlignment.Left
	ItemName.TextTruncate = Enum.TextTruncate.AtEnd
	ItemName.Parent = Frame
	
	local Details = Instance.new("TextLabel")
	Details.Position = UDim2.fromOffset(16, 54)
	Details.Size = UDim2.new(1, -25, 0, 17)
	Details.BackgroundTransparency = 1
	Details.Font = Enum.Font.Gotham
	Details.TextSize = 11
	Details.TextColor3 = Color3.fromRGB(180, 185, 195)
	Details.TextXAlignment = Enum.TextXAlignment.Left
	Details.TextTruncate = Enum.TextTruncate.AtEnd
	Details.Parent = Frame
	
	local function Notify(Name, IsDuplicate)
	    if not CustomEnabled then
	        return
	    end
	
	    Name = tostring(Name or "Unknown")
	
	    local Component = Components:FindFirstChild(Name)
	    local Rarity = Component and Component:GetAttribute("Rarity")
	    Rarity = Rarity or "Common"
	
	    local Color = Colors[Rarity] or Colors.Common
	
	    Header.Text = IsDuplicate == true
	        and "DUPLICATE"
	        or "COMPONENT OBTAINED"
	
	    ItemName.Text = Name
	    ItemName.TextColor3 = Color
	
	    Accent.BackgroundColor3 = Color
	    Stroke.Color = Color
	
	    if IsDuplicate == true then
	        local Amount = Coins[Rarity]
	
	        Details.Text = Amount
	            and ("Converted to " .. Amount .. " Canny Coins")
	            or "Duplicate component"
	    else
	        Details.Text = "Rarity: " .. tostring(Rarity)
	    end
	
	    NotificationId += 1
	    local CurrentId = NotificationId
	
	    Frame.Visible = true
	
	    task.delay(NOTIFICATION_TIME, function()
	        if NotificationId == CurrentId and Frame.Parent then
	            Frame.Visible = false
	        end
	    end)
	end

	local function CustomMenu(State)
	    CustomEnabled = State == true
	
	    if CustomEnabled then
	        Gui.Enabled = true
	
	        local OriginalGui = PlayerGui:FindFirstChild(
	            "StochasticRemunerationGUI"
	        )
	
	        if OriginalGui then
	            ProtectOldGui(OriginalGui)
	        end
	
	        Disconnect(GuiAddedConnection)
	
	        GuiAddedConnection = PlayerGui.ChildAdded:Connect(function(Child)
	            if not CustomEnabled then
	                return
	            end
	
	            if Child.Name == "StochasticRemunerationGUI" then
	                task.defer(function()
	                    if CustomEnabled and Child.Parent == PlayerGui then
	                        ProtectOldGui(Child)
	                    end
	                end)
	            end
	        end)
	
	        if not RewardConnection then
	            RewardConnection = RewardEvent.OnClientEvent:Connect(
	                function(Name, IsDuplicate)
	                    Notify(Name, IsDuplicate)
	                end
	            )
	        end
	    else
	        NotificationId += 1
	        Frame.Visible = false
	        Gui.Enabled = false
	
	        Disconnect(RewardConnection)
	        Disconnect(GuiAddedConnection)
	        RewardConnection = nil
	        GuiAddedConnection = nil
	
	        ClearProtection()
	
	        if OldMain and OldMain.Parent then
	            OldMain.Disabled = OldMainDisabled
	        end
	
	        if OldGui and OldGui.Parent then
	            OldGui.Enabled = OldGuiEnabled
	        end
	
	        OldMain = nil
	        OldGui = nil
	        OldMainDisabled = nil
	        OldGuiEnabled = nil
	    end
	end
	
	local Environment = _G
	
	if type(getgenv) == "function" then
	    local Success, Result = pcall(getgenv)
	
	    if Success and type(Result) == "table" then
	        Environment = Result
	    end
	end
	
	Environment.CustomMenu = CustomMenu

	toggl_custom_Stochastic_Blueprint_Remuneration = Section:NewToggle("custom : Stochastic Blueprint Remuneration", "Blueprints Auto-farming", function(state)
		CustomMenu(state)
	end)
end

