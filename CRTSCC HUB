local function ParseCoins(text)
    text = tostring(text):upper():gsub(",", ""):gsub("%s+", "")
    local number = tonumber(text:match("[%d%.]+"))
    local suffix = text:match("[KMBT]$")

    if not number then return 0 end

    local multipliers = {K = 1e3, M = 1e6, B = 1e9, T = 1e12}
    return math.floor(number * (multipliers[suffix] or 1))
end

local function getcoins()
    return ParseCoins(game:GetService("Players").LocalPlayer.PlayerGui.SalvageGUI.Display.Counter.Labels.Points.Counter.Text)
end

