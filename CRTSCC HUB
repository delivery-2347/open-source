function ShowImage(ImageId, Duration)
    if not ImageId or tostring(ImageId) == "" then return end
    Duration = tonumber(Duration) or 5
    Duration = math.max(0, Duration)

    PopupVersion += 1
    local Version = PopupVersion

    if not PopupGui or not PopupGui.Parent then
        PopupGui = Instance.new("ScreenGui")
        PopupGui.Name = "CucumberImagePopup"
        PopupGui.IgnoreGuiInset = true
        PopupGui.ResetOnSpawn = false
