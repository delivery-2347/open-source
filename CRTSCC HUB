function ShowImage(ImageId, Duration)
    if not ImageId or tostring(ImageId) == "" then return end
    Duration = tonumber(Duration) or 5
    Duration = math.max(0, Duration)

    PopupVersion += 1
    local Version = PopupVersion

    if not PopupGui or not PopupGui.Parent then
        PopupGui = Instance.new("ScreenGui")
        PopupGui.Name = "CucumberImagePopup"
        PopupGui.IgnoreGuiInset = true
        PopupGui.ResetOnSpawn = false
        PopupGui.DisplayOrder = 999999

        local Frame = Instance.new("Frame")
        Frame.Name = "ImageFrame"
        Frame.Size = UDim2.fromOffset(94, 94)
        Frame.Position = UDim2.new(1, -16, 0, 16)
        Frame.AnchorPoint = Vector2.new(1, 0)
        Frame.BackgroundColor3 = Color3.fromRGB(10, 14, 12)
        Frame.BackgroundTransparency = 0.1
        Frame.BorderSizePixel = 0
        Frame.Parent = PopupGui

        local Stroke = Instance.new("UIStroke")
        Stroke.Color = Color3.fromRGB(45, 200, 100)
        Stroke.Thickness = 2
        Stroke.Parent = Frame

        PopupImage = Instance.new("ImageLabel")
        PopupImage.Name = "Image"
        PopupImage.Position = UDim2.fromOffset(3, 3)
        PopupImage.Size = UDim2.new(1, -6, 1, -6)
        PopupImage.BackgroundTransparency = 1
        PopupImage.BorderSizePixel = 0
        PopupImage.ScaleType = Enum.ScaleType.Fit
        PopupImage.Parent = Frame

        local Success = pcall(function()
            if typeof(gethui) == "function" then
                PopupGui.Parent = gethui()
            else
                PopupGui.Parent = CoreGui
            end
        end)

        if not Success then
            local PlayerGui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")

            if PlayerGui then
                PopupGui.Parent = PlayerGui
            else
                PopupGui:Destroy()
                PopupGui = nil
                PopupImage = nil
                return
            end
        end
    end

    PopupImage.Image = tostring(ImageId)
    PopupGui.Enabled = true

    task.delay(Duration, function()
        if PopupVersion == Version and PopupGui then
            PopupGui:Destroy()
            PopupGui = nil
            PopupImage = nil
        end
    end)
end

function NormalizeIcon(iconId)
    if iconId == nil or tostring(iconId) == "" then return nil end
    local icon = tostring(iconId):match("^%s*(.-)%s*$")
    if icon:match("^rbxthumb://") then return icon end
    local id = icon:match("^rbxassetid://(%d+)$") or icon:match("^assetid://(%d+)$") or icon:match("^[%s]*(%d+)[%s]*$") or icon:match("[?&]id=(%d+)")
    if not id then return icon end
    if icon:match("^rbxassetid://") or icon:match("^assetid://") then return "rbxassetid://" .. id end
    return "rbxthumb://type=Asset&id=" .. id .. "&w=150&h=150"
end

function SISTEM_uvidomleniya(title, content, duration, iconId, button1, button2, callback)
    local notification = {
        Title = title,
        Text = content,
        Duration = duration,
        Icon = NormalizeIcon(iconId)
    }
    if button1 or button2 then
        local Bindable = Instance.new("BindableFunction")

        Bindable.OnInvoke = function(button)
            if callback then
                callback(button)
            end
        end
        notification.Button1 = button1
        notification.Button2 = button2
        notification.Callback = Bindable
    end
    game:GetService("StarterGui"):SetCore("SendNotification", notification)
end

