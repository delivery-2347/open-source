	    Legendary = 750,
	}
	
	local Colors = {
	    Common = Color3.fromRGB(180, 180, 180),
	    Uncommon = Color3.fromRGB(80, 200, 120),
	    Rare = Color3.fromRGB(80, 150, 255),
	    Epic = Color3.fromRGB(185, 100, 255),
	    Legendary = Color3.fromRGB(255, 177, 65),
	    Hidden = Color3.fromRGB(255, 80, 100),
	}
	
	local CustomEnabled = false
	local NotificationId = 0
	
	local OldGui
	local OldMain
	local OldGuiEnabled
	local OldMainDisabled
	
	local ProtectionConnections = {}
	local GuiAddedConnection
	local RewardConnection
	
	local function Disconnect(Connection)
	    if Connection then
	        Connection:Disconnect()
	    end
	end
	
	local function ClearProtection()
	    for _, Connection in ipairs(ProtectionConnections) do
	        Disconnect(Connection)
	    end
	
	    table.clear(ProtectionConnections)
	end
	
	local function FindMain(Gui)
	    local Frame1 = Gui:FindFirstChild("Frame")
	    local Frame2 = Frame1 and Frame1:FindFirstChild("Frame")
	    local Main = Frame2 and Frame2:FindFirstChild("Main")
	
	    if Main and Main:IsA("LocalScript") then
	        return Main
	    end
	
	    return nil
	end
	
	local function ProtectMain(Main)
	    if not Main or not Main:IsA("LocalScript") then
	        return
	    end
	
	    if OldMain == Main then
	        Main.Disabled = true
	        return
	    end
	
	    OldMain = Main
	    OldMainDisabled = Main.Disabled
	
	    table.insert(
	        ProtectionConnections,
	        Main:GetPropertyChangedSignal("Disabled"):Connect(function()
	            if CustomEnabled and not Main.Disabled then
	                Main.Disabled = true
	            end
	        end)
	    )
	
	    Main.Disabled = true
	end
	
	local function ProtectOldGui(Gui)
	    if not CustomEnabled or not Gui then
	        return
	    end
	
	    if OldGui ~= Gui then
	        ClearProtection()
	
	        OldGui = Gui
	        OldGuiEnabled = Gui.Enabled
	        OldMain = nil
	        OldMainDisabled = nil
	
	        table.insert(
	            ProtectionConnections,
	            Gui:GetPropertyChangedSignal("Enabled"):Connect(function()
	                if CustomEnabled and Gui.Enabled then
	                    Gui.Enabled = false
	                end
	            end)
	        )
	
	        table.insert(
	            ProtectionConnections,
	            Gui.DescendantAdded:Connect(function(Object)
	                if CustomEnabled
	                    and Object.Name == "Main"
	                    and Object:IsA("LocalScript") then
	
	                    task.defer(function()
	                        if CustomEnabled and Object.Parent then
	                            local FoundMain = FindMain(Gui)
	
	                            if FoundMain then
	                                ProtectMain(FoundMain)
	                            end
	                        end
	                    end)
	                end
	            end)
	        )
	    end
	
	    local Main = FindMain(Gui)
	
	    if Main then
	        ProtectMain(Main)
	    end
	
	    if OldMain then
	        OldMain.Disabled = true
	    end
	
	    Gui.Enabled = false
	end
	
	local PreviousGui = PlayerGui:FindFirstChild("StochasticNotificationGUI")
	
	if PreviousGui then
	    PreviousGui:Destroy()
	end
	
	local Gui = Instance.new("ScreenGui")
