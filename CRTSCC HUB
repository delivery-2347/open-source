    local function GetFolders()
        local Folders = {}
        local Islands = workspace:FindFirstChild("Islands")
        local CartDepot = Islands and Islands:FindFirstChild("CartDepot")
        local Scrapyard = Islands and Islands:FindFirstChild("Scrapyard")

        local function AddFolder(Parent, Name)
            local Folder = Parent and Parent:FindFirstChild(Name)
            if Folder then table.insert(Folders, Folder) end
        end

        AddFolder(CartDepot, "CartDepotDecor")
        AddFolder(workspace, "LooseItems")
        AddFolder(workspace, "Carts")
        AddFolder(Scrapyard, "Decor")
        AddFolder(Scrapyard, "SpawnableParts")

        return Folders
    end

    local function GetPosition(Obj)
        if Obj:IsA("BasePart") then
            return Obj.Position
        elseif Obj:IsA("Model") then
            return Obj:GetPivot().Position
        elseif Obj:IsA("Tool") then
            local Handle = Obj:FindFirstChild("Handle")
            return Handle and Handle.Position
        end
    end

    local function ScanFolder(Folder, Origin)
        for _, Obj in ipairs(Folder:GetDescendants()) do
            local Pos = GetPosition(Obj)
            if Pos and (Pos - Origin).Magnitude <= 15 then
                pcall(function()
                    Remote:FireServer(Obj)
                end)
            end
        end
    end

    Section:NewKeybind("Salvage Object : instant", "Подсказка", Enum.KeyCode.G, function()
        if not ENEIBLE or not Remote then return end

        local Char = Player.Character
        local HRP = Char and Char:FindFirstChild("HumanoidRootPart")
        if not HRP then return end

        for _, Folder in ipairs(GetFolders()) do
            ScanFolder(Folder, HRP.Position)
        end
    end)
end

