    Details.TextTruncate = Enum.TextTruncate.AtEnd
    Details.Parent = Frame

    local function Notify(Name, IsDuplicate)
        if not CustomEnabled then return end

        Name = tostring(Name or "Unknown")
        local Component = Components:FindFirstChild(Name)
        local Rarity = (Component and Component:GetAttribute("Rarity")) or "Common"
        local Color = Colors[Rarity] or Colors.Common

        Header.Text = IsDuplicate == true and "DUPLICATE" or "COMPONENT OBTAINED"
        ItemName.Text, ItemName.TextColor3 = Name, Color
        Accent.BackgroundColor3, Stroke.Color = Color, Color

        if IsDuplicate == true then
