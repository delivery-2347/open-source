        TweenInfo.new(
            5,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.In,
            -1,
            true
        ),
        {
            FillTransparency = 0.9,
            OutlineColor = Color3.fromRGB(191, 206, 255)
        }
    ):Play()

    local function ClearHighlights()
        MouseoverHighlight.Adornee = nil
        DraggingHighlight.Adornee = nil
    end

    local RayParams = RaycastParams.new()
    RayParams.FilterType = Enum.RaycastFilterType.Exclude

    local function RefreshRaycastFilter()
        local Ignore = {}
        if Player.Character then table.insert(Ignore, Player.Character) end
        for _, Name in ipairs({
            "GrabIgnore",
            "RaycastIgnore"
        }) do
            local Object = workspace:FindFirstChild(Name)
            if Object then
                table.insert(Ignore, Object)
            end
        end
        RayParams.FilterDescendantsInstances = Ignore
    end

    RefreshRaycastFilter()

    Player.CharacterAdded:Connect(function()
        task.wait()
        RefreshRaycastFilter()
    end)

    local function GetMouseRay()
        local Camera = workspace.CurrentCamera
        local Mouse = UIS:GetMouseLocation()
        return Camera:ViewportPointToRay(Mouse.X, Mouse.Y)
    end

    local function CanGrabPart(Part)
        if not Part or not Part:IsA("BasePart") then return false end
        if Part.Anchored or Part:HasTag("Ungrabbable") then return false end
        if Part:HasTag("PlayerCharacter") then return false end

        local ClickDetector = Part:FindFirstChildOfClass("ClickDetector")
        if ClickDetector and ClickDetector.MaxActivationDistance > 0 then return false end

        local Parent = Part.Parent

        while Parent and Parent ~= workspace and Parent.ClassName ~= "Folder" do
            local Humanoid = Parent:FindFirstChildOfClass("Humanoid")
            if Humanoid and Humanoid.Health > 0 then return false end
            Parent = Parent.Parent
        end
        for _, Connected in ipairs(Part:GetConnectedParts(true)) do
            if Connected.Anchored then
                return false
            end
        end
        return true
    end

    local function StopCustom()
        SetRotationMovement(false)
        if Custom.Connection then
            Custom.Connection:Disconnect()
            Custom.Connection = nil
        end

        local Part = Custom.Part

        if Custom.Position then
            Custom.Position:Destroy()
            Custom.Position = nil
        end
        if Custom.Gyro then
            Custom.Gyro:Destroy()
            Custom.Gyro = nil
        end

        if Part and Part.Parent then DragEnd:FireServer(Part) end

        Custom.Part = nil
        Custom.Keys = {}
        Custom.Rotating = false
        Custom.Rotation = CFrame.new()
        DraggingHighlight.Adornee = nil
    end

    local function StartCustom()
        if Mode ~= "Custom" then return false end
        if Custom.Part then StopCustom() end

        local Camera = workspace.CurrentCamera
        local Ray = GetMouseRay()

        local Result = workspace:Raycast(
            Ray.Origin,
            Ray.Direction * MaxRayDistance,
            RayParams
        )

        if not Result then return false end

        local Part = Result.Instance

        if not CanGrabPart(Part) then return false end

        local CameraRotation = Camera.CFrame - Camera.CFrame.Position
        local Offset = Part.CFrame:ToObjectSpace(CFrame.new(Result.Position) * CameraRotation)
        Custom.Offset = Offset:Inverse()
        Custom.Distance = (Result.Position - Camera.CFrame.Position).Magnitude
        Custom.Rotation = CFrame.new()
        Custom.Part = Part

        local BodyPosition = Instance.new("BodyPosition")
        BodyPosition.MaxForce = Vector3.new(50000, 50000, 50000)
        BodyPosition.P = 2500
        BodyPosition.D = 200
        BodyPosition.Position = Part.Position
        BodyPosition.Parent = Part

        local BodyGyro = Instance.new("BodyGyro")
        BodyGyro.MaxTorque = Vector3.new(10000, 10000, 10000)
        BodyGyro.P = 2500
        BodyGyro.D = 100
        BodyGyro.CFrame = Part.CFrame
        BodyGyro.Parent = Part
        Custom.Position = BodyPosition
        Custom.Gyro = BodyGyro
        MouseoverHighlight.Adornee = nil
        DraggingHighlight.Adornee = Part

        DragBegin:FireServer(Part)

        Custom.Connection = RunService.Heartbeat:Connect(function(Delta)
            if not Custom.Part or not Custom.Part.Parent then StopCustom(); return end

            local CurrentCamera = workspace.CurrentCamera
            if not CurrentCamera then StopCustom(); return end

            local Ray = GetMouseRay()

            local Target =
                CurrentCamera.CFrame.Position
                + Ray.Direction * Custom.Distance

            if Custom.Rotating then
                local Keys = Custom.Keys
                local Rotation = Vector3.new(
                    (Keys[Enum.KeyCode.S] and 1 or 0)
                        - (Keys[Enum.KeyCode.W] and 1 or 0),

                    (Keys[Enum.KeyCode.A] and 1 or 0)
                        - (Keys[Enum.KeyCode.D] and 1 or 0),

                    (Keys[Enum.KeyCode.Q] and 1 or 0)
                        - (Keys[Enum.KeyCode.E] and 1 or 0)
                ) * Delta * 1.2
                Custom.Rotation =
                    CFrame.Angles(0, Rotation.Y, 0)
                    * CFrame.Angles(Rotation.X, 0, 0)
                    * CFrame.Angles(0, 0, Rotation.Z)
                    * Custom.Rotation
            end

            local CameraRotation =
                CurrentCamera.CFrame - CurrentCamera.CFrame.Position

            local TargetCFrame =
                CFrame.new(Target)
                * CameraRotation
                * Custom.Rotation
                * Custom.Offset

            Custom.Position.Position = TargetCFrame.Position
            Custom.Gyro.CFrame = TargetCFrame
        end)
        return true
    end

    local function UpdateHighlight()
        if Mode ~= "Custom" then ClearHighlights(); return end
        if Custom.Part then
            MouseoverHighlight.Adornee = nil
            DraggingHighlight.Adornee = Custom.Part
            return
        end

        DraggingHighlight.Adornee = nil
        local Ray = GetMouseRay()

        local Result = workspace:Raycast(
            Ray.Origin,
            Ray.Direction * MaxRayDistance,
            RayParams
        )
        if Result and CanGrabPart(Result.Instance) then
            MouseoverHighlight.Adornee = Result.Instance
        else
            MouseoverHighlight.Adornee = nil
        end
    end

    RunService.RenderStepped:Connect(UpdateHighlight)

    local function castom_grab(Start)
        if not Start then
            GrabBlocked = true
            StopCustom()
            return true
        end
        return not GrabBlocked and StartCustom()
    end

    local function set_grab_mode(CustomMode)
        if typeof(CustomMode) ~= "boolean" then return false end
        StopCustom()
        ClearHighlights()
        Mode = "Switching"
        if CustomMode then
            local Drop = Original:FindFirstChild("Drop")

            if Drop and Drop:IsA("BindableEvent") then
                Drop:Fire()
            end
            RunService.Heartbeat:Wait()
            Original.Disabled = true
            Mode = "Custom"
        else
            Original.Disabled = false
            Mode = "Original"
        end
        return true
    end

    UIS.InputBegan:Connect(function(Input, Processed)
        if Mode ~= "Custom" or Processed then return end
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then
            GrabBlocked = false
            castom_grab(true)
            return
        end
        if Input.KeyCode == Enum.KeyCode.LeftShift then SetRotationMovement(true) end
        Custom.Keys[Input.KeyCode] = true
    end)

    UIS.InputEnded:Connect(function(Input)
        if Mode ~= "Custom" then return end
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then
            castom_grab(false)
            return
        end
        if Input.KeyCode == Enum.KeyCode.LeftShift then SetRotationMovement(false) end
        Custom.Keys[Input.KeyCode] = false
    end)

    
    toglall.Patch_grab = Section:NewToggle("Patch grab", "Подсказка",function(start)
        set_grab_mode(start)
    end)
end

