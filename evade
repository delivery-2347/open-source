local ENEIBLE = true
local Liabirigi_suska = loadstring(game:HttpGet("https://raw.githubusercontent.com/delivery-2347/w/refs/heads/main/super%20puper%20optimezison"))()

local CUCUMBER = {
    SchemeColor = Color3.fromRGB(45, 160, 95),
    Background = Color3.fromRGB(8, 18, 12),
    Header = Color3.fromRGB(12, 30, 20),
    TextColor = Color3.fromRGB(230, 230, 230),
    ElementColor = Color3.fromRGB(18, 55, 38)
}

local Window = Liabirigi_suska.CreateLib("🥒 CUCUMBER HUB EVADE 🥒", CUCUMBER)

local Tab = Window:NewTab("menu")

local Section = Tab:NewSection("by DELIVERY")

repeat
    for _, gui in ipairs(game:GetService("CoreGui"):GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name:match("^%d+$") then
            local title = gui:FindFirstChild("title", true)
            if title and title:IsA("TextLabel") and title.Text:find("CUCUMBER HUB EVADE", 1, true) then
                ril_nem = gui
                break
            end
        end
    end
    task.wait(0.05)
until ril_nem

do
    local AutoJump = false

    Section:NewKeybind("Auto Jump", "Авто прыжок", Enum.KeyCode.V, function()
        AutoJump = not AutoJump

        task.spawn(function()
            while AutoJump and ENEIBLE do
                local char = game.Players.LocalPlayer.Character
                local hum = char and char:FindFirstChildWhichIsA("Humanoid")

                if hum and hum.FloorMaterial ~= Enum.Material.Air then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end

                task.wait(0.1)
            end
        end)
    end)
end

do
    local AutoCtrl = false
    local taimvontrl = 0.1
    local VIM = game:GetService("VirtualInputManager")

    Section:NewKeybind("Auto Ctrl", "Авто Ctrl", Enum.KeyCode.B, function()
        AutoCtrl = not AutoCtrl

        if AutoCtrl then
            task.spawn(function()
                while AutoCtrl and ENEIBLE do
                    task.wait(taimvontrl)
                    VIM:SendKeyEvent(true, Enum.KeyCode.LeftControl, false, game)
                    task.wait(taimvontrl)
                    VIM:SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game)
                end
            end)
        end
    end)

    Section:NewTextBox("zaderska dlya Auto Ctrl", "nahui", function(text)
        local value = tonumber(text)

        if value and value >= 0 and value <= 1 then
            taimvontrl = value
        end
    end)
end

