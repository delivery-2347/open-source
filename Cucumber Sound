local delayTime = 0.5
local sliderDragging = false

local function updateSlider(x)
	local percent = math.clamp(
		(x - sliderBack.AbsolutePosition.X) / sliderBack.AbsoluteSize.X,
		0,
		1
	)

	delayTime = percent * 2

	sliderFill.Size = UDim2.new(percent, 0, 1, 0)
	sliderKnob.Position = UDim2.new(percent, -3, 0.5, -3)
	sliderText.Text = string.format("Delay: %.2fs", delayTime)
end

sliderBack.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		sliderDragging = true
		updateSlider(input.Position.X)
	end
end)

sliderKnob.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		sliderDragging = true
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if sliderDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		updateSlider(input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		sliderDragging = false
	end
end)

local running = false
local workerId = 0

local function getChannel()
	local channels = TextChatService:FindFirstChild("TextChannels")

	if not channels then
		return nil
	end

	return channels:FindFirstChild("RBXGeneral")
end

local function sendSound(value)
	local channel = getChannel()

	if not channel then
		return
	end

	task.spawn(function()
		pcall(function()
			channel:SendAsync("/w . " .. tostring(value))
		end)
	end)
end

local function getSelectedSounds()
	local result = {}

	for _, value in ipairs(selectedOrder) do
		if selectedSounds[value] then
			table.insert(result, value)
		end
	end

	return result
end

local function startWorker()
	workerId += 1

	local currentWorker = workerId

	task.spawn(function()
		while running and currentWorker == workerId and gui.Parent do
			local sounds = getSelectedSounds()

			if #sounds == 0 then
				task.wait(0.05)
				continue
			end

			for _, value in ipairs(sounds) do
				if not running or currentWorker ~= workerId then
					break
				end

				sendSound(value)

				if delayTime > 0 then
					task.wait(delayTime)
				else
					task.wait()
				end
			end
		end
	end)
end

toggle.MouseButton1Click:Connect(function()
	running = not running

	if running then
		toggle.Text = "ON"
		startWorker()
	else
		workerId += 1
		toggle.Text = "OFF"
	end
end)

