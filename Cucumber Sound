			for i = #selectedOrder, 1, -1 do
				if selectedOrder[i] == value then
					table.remove(selectedOrder, i)
					break
				end
			end
		else
			selectedSounds[value] = true
			table.insert(selectedOrder, value)
		end

		updateSoundButton(button, value)
		updateSelectedText()
	end)
end

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	list.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y)
end)

local scrollTarget = 0

local function getMaxScroll()
	return math.max(0, layout.AbsoluteContentSize.Y - list.AbsoluteSize.Y)
end

local function smoothScroll(amount)
	local maxScroll = getMaxScroll()

	scrollTarget = math.clamp(
		scrollTarget + amount,
		0,
		maxScroll
	)

	TweenService:Create(
		list,
		TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			CanvasPosition = Vector2.new(0, scrollTarget)
		}
	):Play()
end

list.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		smoothScroll(-input.Position.Z * 22)
	end
end)

for _, button in pairs(soundButtons) do
	button.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			smoothScroll(-input.Position.Z * 22)
		end
	end)
end

