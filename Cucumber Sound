local selectedSounds = {}
local selectedOrder = {}
local soundButtons = {}

local function selectedCount()
	local count = 0

	for _ in pairs(selectedSounds) do
		count += 1
	end

	return count
end

local function updateSelectedText()
	local count = selectedCount()

	selectedLabel.Text = string.format("%d selected", count)

	if count == 0 then
		dropdown.Text = "Select Sounds"
	elseif count == 1 then
		local onlyOne

		for value in pairs(selectedSounds) do
			onlyOne = value
			break
		end

		dropdown.Text = tostring(onlyOne)
	else
		dropdown.Text = string.format("%d sounds selected", count)
	end
end

local function updateSoundButton(button, value)
	if selectedSounds[value] then
		button.Text = "✓ " .. value
		button.TextColor3 = Color3.fromRGB(0, 255, 0)
	else
		button.Text = "  " .. value
		button.TextColor3 = Color3.fromRGB(0, 180, 0)
	end
end

