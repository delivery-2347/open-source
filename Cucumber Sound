local draggingObject = nil
local dragStart = nil
local dragObjectStart = nil
local dragMoved = false

local function beginDrag(object, input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
		return
	end

	draggingObject = object
	dragStart = input.Position
	dragObjectStart = object.AbsolutePosition
	dragMoved = false
end

local function updateDrag(input)
	if not draggingObject then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement then
		return
	end

	local delta = input.Position - dragStart

	if math.abs(delta.X) > 2 or math.abs(delta.Y) > 2 then
		dragMoved = true
	end

	draggingObject.Position = UDim2.fromOffset(
		dragObjectStart.X + delta.X,
		dragObjectStart.Y + delta.Y
	)
end

local function endDrag()
	if not draggingObject then
		return false
	end

	local wasMoved = dragMoved

	draggingObject = nil
	dragStart = nil
	dragObjectStart = nil
	dragMoved = false

	return wasMoved
end

