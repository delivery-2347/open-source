	beginDrag(frame, input)
end)

popup.InputBegan:Connect(function(input)
	beginDrag(popup, input)
end)

UserInputService.InputChanged:Connect(function(input)
	updateDrag(input)
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local wasMoved = endDrag()

		if popup.Visible and wasMoved then
			popup:SetAttribute("WasDragged", true)

			task.delay(0.05, function()
				if popup then
					popup:SetAttribute("WasDragged", false)
				end
			end)
		end
	end
end)

