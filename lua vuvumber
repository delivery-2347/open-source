    bullet_texture_state.texture = normalized
    local folder = bullet_texture_state.folder or workspace:FindFirstChild("BulletHoles")
    if folder then
        local texture = bullet_texture_state.enabled and normalized or DEFAULT_BULLET_HOLE_TEXTURE
        apply_to_existing_bullet_holes(folder, texture)
        return true
    end
    return false
end

local function set_always_apply_bullet_holes(enabled)
    if enabled == nil and always_apply_bullets then
        enabled = always_apply_bullets:get()
    end
    bullet_texture_state.enabled = enabled == true
    bullet_texture_state.token += 1
    local token = bullet_texture_state.token
    if not bullet_texture_state.enabled then
        if always_apply_bullets then
            always_apply_bullets:set(false, true)
        end
        stop_bullet_hole_watch()
        local folder = workspace:FindFirstChild("BulletHoles")
        if folder then
            apply_to_existing_bullet_holes(folder, DEFAULT_BULLET_HOLE_TEXTURE)
        end
        return
    end

    bullet_texture_state.texture = NormalizeIcon(bullet_texture_input:get()) or DEFAULT_BULLET_HOLE_TEXTURE
    local folder = workspace:FindFirstChild("BulletHoles")
    if folder then
        watch_bullet_hole_folder(folder)
    end
    task.spawn(function()
        while bullet_texture_state.enabled and bullet_texture_state.token == token do
            local current_folder = workspace:FindFirstChild("BulletHoles")
            if current_folder then
                watch_bullet_hole_folder(current_folder)
                apply_to_existing_bullet_holes(current_folder, bullet_texture_state.texture or DEFAULT_BULLET_HOLE_TEXTURE)
            end
            task.wait(0.2)
        end
    end)
end

local function cleanup_bullet_hole_images()
    for hole, record in pairs(bullet_hole_images) do
        pcall(function()
