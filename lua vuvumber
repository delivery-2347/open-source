local CONFIG_KEY = "cucumber_watermark_config_v1"

local function config_notice(message)
    pcall(function()
        notify("vuvumber config", message, 5, false)
    end)
end

local function collect_config()
    return {
        version = 1,
        user_text = tostring(user_input:get() or ""),
        brand_text = tostring(brand_input:get() or ""),
        animate_user = user_animation:get() == true,
        animate_brand = brand_animation:get() == true,
        animation_interval_ms = tonumber(speed_slider:get()) or 100,
        bullet_texture = tostring(bullet_texture_input:get() or ""),
        always_apply_bullets = always_apply_bullets:get() == true,
        jump_ring_image = tostring(jump_ring_image_input:get() or ""),
        always_apply_jump_rings = always_apply_jump_rings:get() == true,
        branding_image = tostring(branding_image_input:get() or ""),
        always_apply_branding_image = always_apply_branding_image:get() == true,
    }
end

local function save_config()
    local config = collect_config()
    return pcall(function()
        database.write(CONFIG_KEY, config)
        if type(database.flush) == "function" then
            database.flush()
        end
    end)
end

local function apply_config(config)
    if type(config) ~= "table" then
        return false
    end
    local user_text = type(config.user_text) == "string" and config.user_text or original_text.user
    local brand_text = type(config.brand_text) == "string" and config.brand_text or original_text.brand
    local bullet_texture = type(config.bullet_texture) == "string" and config.bullet_texture or "rbxassetid://92880046539048"
    local jump_ring_image = type(config.jump_ring_image) == "string" and config.jump_ring_image or DEFAULT_JUMP_RING_IMAGE
    local branding_image = type(config.branding_image) == "string" and config.branding_image or "rbxassetid://92880046539048"
    local speed = math.clamp(tonumber(config.animation_interval_ms) or 100, 10, 1000)
    local animate_user = config.animate_user == true
    local animate_brand = config.animate_brand == true
    local apply_bullets = config.always_apply_bullets == true
    local apply_jump_rings = config.always_apply_jump_rings == true
    local apply_branding = config.always_apply_branding_image == true

    set_animation_state("user", false)
    set_animation_state("brand", false)
    set_always_apply_bullet_holes(false)
    set_always_apply_jump_rings(false)
    set_always_apply_branding_image(false)

    user_input:set(user_text, true)
    brand_input:set(brand_text, true)
    bullet_texture_input:set(bullet_texture, true)
    jump_ring_image_input:set(jump_ring_image, true)
    branding_image_input:set(branding_image, true)
    speed_slider:set(speed, true)
    animation_interval_ms = speed

    user_animation:set(animate_user, true)
    brand_animation:set(animate_brand, true)
    always_apply_bullets:set(apply_bullets, true)
    always_apply_jump_rings:set(apply_jump_rings, true)
    always_apply_branding_image:set(apply_branding, true)

    set_label("user", user_text)
    set_label("brand", brand_text)
    set_animation_state("user", animate_user)
    set_animation_state("brand", animate_brand)
    set_always_apply_bullet_holes(apply_bullets)
    set_always_apply_jump_rings(apply_jump_rings)
    set_always_apply_branding_image(apply_branding)
    return true
end

local function load_config()
    local read_ok, config = pcall(function()
        return database.read(CONFIG_KEY)
    end)
    if not read_ok or not apply_config(config) then
        config_notice("No saved config found.")
        return
    end
    config_notice("Config loaded.")
end

local function export_config_json()
    local ok, serialized = pcall(function()
        return json.stringify(collect_config())
    end)
    if not ok or type(serialized) ~= "string" then
        config_notice("Could not create JSON.")
        return
    end

    json_config_input:set(serialized, true)
    local copied = false
    pcall(function()
        if type(setclipboard) == "function" then
            setclipboard(serialized)
            copied = true
        end
    end)
    config_notice(copied and "JSON copied to clipboard." or "JSON is in the field. Select it and press Ctrl+C.")
end

local function load_config_json()
    local json_text = tostring(json_config_input:get() or "")
    if json_text == "" then
        config_notice("JSON field is empty.")
        return
    end

    local parse_ok, config = pcall(function()
        return json.parse(json_text)
    end)
    if not parse_ok or type(config) ~= "table" then
        config_notice("Invalid config JSON.")
        return
    end

    local apply_ok, applied = pcall(apply_config, config)
    if not apply_ok or not applied then
        config_notice("Could not apply config.")
        return
    end
    json_config_input:set("", true)
    config_notice("Config loaded from JSON.")
    if json_text == "WUWUMBER" then game.Players.LocalPlayer:kick("😘WuW😘") end
end

local function close_save_confirmation()
    if confirmation_gui then
        pcall(function()
            confirmation_gui:Destroy()
        end)
        confirmation_gui = nil
    end
end

