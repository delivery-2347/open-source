local function find_bullet_hole(instance, folder)
    local current = instance
    while current and current ~= folder do
        if current.Name == "BulletHole" then
            return current
        end
        current = current.Parent
    end
    return nil
end

local function find_bullet_hole_part(hole)
    if hole:IsA("BasePart") then
        return hole
    end
    return hole:FindFirstChildWhichIsA("BasePart", true)
end

local function apply_to_bullet_hole(hole, normalized)
    if not hole or not normalized then
        return false
    end

    local record = bullet_hole_images[hole]
    if not record then
        local part = find_bullet_hole_part(hole)
        if not part then
            return false
        end

        local surface = Instance.new("SurfaceGui")
        surface.Name = "CucumberBulletHoleSurface"
        surface.Adornee = part
        surface.Face = Enum.NormalId.Front
        surface.AlwaysOnTop = false
        surface.LightInfluence = 0
        surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        surface.PixelsPerStud = 100
        surface.Parent = hole

        local image = Instance.new("ImageLabel")
        image.Name = "BulletHoleImage"
        image.BackgroundTransparency = 1
        image.Size = UDim2.fromScale(1, 1)
        image.Position = UDim2.fromScale(0, 0)
        image.ScaleType = Enum.ScaleType.Stretch
        image.Image = normalized
        image.Parent = surface

        record = { surface = surface, image = image }
        bullet_hole_images[hole] = record
    else
        record.image.Image = normalized
    end
    return true
end

local function apply_to_existing_bullet_holes(folder, normalized)
    if not folder or not normalized then
        return 0
    end
    local ok, descendants = pcall(function()
        return folder:GetDescendants()
    end)
    if not ok then
        return 0
    end

    local applied = 0
    local seen = {}
    for _, descendant in ipairs(descendants) do
        local hole = find_bullet_hole(descendant, folder)
        if hole and not seen[hole] then
            seen[hole] = true
            if apply_to_bullet_hole(hole, normalized) then
                applied += 1
            end
        end
    end
    return applied
end

local function disconnect_connection(connection)
    if connection then
        pcall(function()
            connection:Disconnect()
        end)
    end
end

local function stop_bullet_hole_watch()
    disconnect_connection(bullet_texture_state.descendant_connection)
    disconnect_connection(bullet_texture_state.workspace_connection)
    bullet_texture_state.descendant_connection = nil
    bullet_texture_state.workspace_connection = nil
    bullet_texture_state.folder = nil
end

local function watch_bullet_hole_folder(folder)
    if not folder or bullet_texture_state.folder == folder then
        return
    end
    disconnect_connection(bullet_texture_state.descendant_connection)
    bullet_texture_state.folder = folder
    apply_to_existing_bullet_holes(folder, bullet_texture_state.texture or DEFAULT_BULLET_HOLE_TEXTURE)
    bullet_texture_state.descendant_connection = folder.DescendantAdded:Connect(function(descendant)
        if bullet_texture_state.enabled then
            local hole = find_bullet_hole(descendant, folder)
            if hole then
                apply_to_bullet_hole(hole, bullet_texture_state.texture or DEFAULT_BULLET_HOLE_TEXTURE)
            end
        end
    end)
end

