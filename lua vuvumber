local function set_animation_state(kind, enabled)
    local state = animation_state[kind]
    local input = kind == "user" and user_input or brand_input
    local toggle = kind == "user" and user_animation or brand_animation
    if not state or not input then
        return
    end
    if enabled == nil and toggle then
        enabled = toggle:get()
    end
    state.enabled = enabled == true
    state.token += 1
    local token = state.token
    if not state.enabled then
        if toggle then
            toggle:set(false, true)
        end
        set_label(kind, input:get() or "")
        return
    end
    task.spawn(function()
        while state.enabled and state.token == token do
            local target = tostring(input:get() or "")
            local prefixes = {}
            local char_count = utf8.len(target)
            if char_count then
                for index = 1, char_count do
                    local next_byte = utf8.offset(target, index + 1)
                    local end_byte = (next_byte or (#target + 1)) - 1
                    prefixes[index] = target:sub(1, end_byte)
                end
            else
                for index = 1, #target do
                    prefixes[index] = target:sub(1, index)
                end
            end
            for _, prefix in ipairs(prefixes) do
                if not state.enabled or state.token ~= token then
                    return
                end
                set_label(kind, prefix)
                task.wait(animation_interval_ms / 1000)
            end
            for index = #prefixes - 1, 0, -1 do
                if not state.enabled or state.token ~= token then
                    return
                end
                set_label(kind, prefixes[index] or "")
                task.wait(animation_interval_ms / 1000)
            end
            if #prefixes == 0 then
                task.wait(animation_interval_ms / 1000)
            end
        end
    end)
end
