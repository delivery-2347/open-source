local function set_label(kind, value)
    value = tostring(value or "")
    local label = find_watermark_label(kind)
    if not label then
        return false
    end
    local ok = pcall(function()
        label.Text = value
    end)
    return ok
end

local function NormalizeIcon(iconId)
    if iconId == nil or tostring(iconId) == "" then
        return nil
    end
    local icon = tostring(iconId):match("^%s*(.-)%s*$")
    if icon == "" then
        return nil
    end
    if icon:match("^rbxthumb://") then
        return icon
    end
    local id = icon:match("^rbxassetid://(%d+)$")
        or icon:match("^assetid://(%d+)$")
        or icon:match("^%s*(%d+)%s*$")
        or icon:match("[?&]id=(%d+)")
    if not id then
        return icon
    end
    if icon:match("^rbxassetid://") or icon:match("^assetid://") then
        return "rbxassetid://" .. id
    end
    return "rbxthumb://type=Asset&id=" .. id .. "&w=150&h=150"
end

