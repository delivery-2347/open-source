local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

local function find_watermark_label(kind)
    local playerGui = localPlayer and localPlayer:FindFirstChild("PlayerGui")
    local watermark = playerGui and playerGui:FindFirstChild("SynWatermark")
    local frame = watermark and watermark:FindFirstChild("WatermarkFrame")
    if not frame then
        return nil
    end
    if kind == "user" then
        return frame:FindFirstChild("UserLabel")
    end
    local badge = frame:FindFirstChild("BrandBadge")
    return badge and badge:FindFirstChild("BrandLabel") or nil
end

local function read_label(kind)
    local label = find_watermark_label(kind)
    if not label then
        return ""
    end
    local ok, value = pcall(function()
        return label.Text
    end)
    return ok and tostring(value or "") or ""
end

local original_text = {
