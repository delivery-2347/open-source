local Tab = Window:NewTab("FARM")

local Section = Tab:NewSection("by CUCUMBER")

do 
	local conekr

	Section:NewToggle("Blueprints : Auto-farming", "Blueprints Auto-farming", function(state)
	    if state then
	        local spawn = workspace.BlueprintSpawn
	        local player = game.Players.LocalPlayer

	        local function Fire_TouchTransmitter(part)
	            local plr = game:GetService("Players").LocalPlayer
	            local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")

	            if not hrp or not part or not part.Parent then
	                return
	            end

	            firetouchinterest(hrp, part.Parent, 0)
	            task.wait()
	            firetouchinterest(hrp, part.Parent, 1)
	        end

	        local function Blueprints(obj)
	            if obj.Name ~= "Blueprints" then
	                return
	            end

	            local character = player.Character
	            local hrp = character and character:FindFirstChild("HumanoidRootPart")

	            if not hrp then
	                return
	            end

	            Fire_TouchTransmitter(obj:FindFirstChild("TouchInterest"))
	        end

	        for _, obj in ipairs(spawn:GetDescendants()) do
	            Blueprints(obj)
	        end

	        conekr = spawn.DescendantAdded:Connect(Blueprints)
	    else
	        if conekr then
	            conekr:Disconnect()
	            conekr = nil
	        end
	    end
	end)
end

do
	local folders = {
	    workspace.Islands.CartDepot.CartDepotDecor,
	    workspace.LooseItems,
	    workspace.Carts,
		workspace.Islands.CartDepot.CartDepotDecor
	}

	Section:NewKeybind("Salvage Object : instant", "Подсказка", Enum.KeyCode.RightShift, function()
