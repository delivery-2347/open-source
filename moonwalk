local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/delivery-2347/w/refs/heads/main/super%20puper%20optimezison"))()

local Movement = {
    SchemeColor = Color3.fromRGB(105, 120, 190),
    Background = Color3.fromRGB(7, 8, 14),
    Header = Color3.fromRGB(13, 15, 25),
    TextColor = Color3.fromRGB(235, 238, 250),
    ElementColor = Color3.fromRGB(22, 25, 42)
}
local Window = Library.CreateLib(" CUCUMBER Movement ", Movement)

local Tab = Window:NewTab("Moon Walk")

local Section = Tab:NewSection("Violence District = lobby 7 - 0 round = 12 - 0")

local Section = Tab:NewSection("Murder Mystery 2 = 6 - 0")

repeat
    for _, gui in ipairs(game:GetService("CoreGui"):GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name:match("^%d+$") then
            local title = gui:FindFirstChild("title", true)
            if title and title:IsA("TextLabel") and title.Text:find("CUCUMBER Movement", 1, true) then
                ril_nem = gui
                break
            end
        end
    end
    task.wait(0.05)
until ril_nem

do
    local VIM = game:GetService("VirtualInputManager")
    local UIS = game:GetService("UserInputService")

    local moonvolk_eneble = false

    local moonvolk_speed = 0

    local moonvolk_keybind = Enum.KeyCode.E

    local function kakdela(state)
        if not state then
            VIM:SendKeyEvent(false, Enum.KeyCode.D, false, nil)
            VIM:SendKeyEvent(false, Enum.KeyCode.A, false, nil)
        end
    end

    Section:NewTextBox("moonvolk keybind", "moonvolk_keybind", function(txt)
        moonvolk_keybind = Enum.KeyCode[txt:upper()]
    end)

    Section:NewSlider("moonvolk speed", "moonvolk_speed", 100, 0, function(s)
        moonvolk_speed = s / 100
    end)

    Section:NewToggle("moonvolk eneble", "moonvolk_eneble", function(state)
        moonvolk_eneble = state
        kakdela(state)
    end)

    UIS.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == moonvolk_keybind and moonvolk_eneble then
            task.spawn(function()
                while UIS:IsKeyDown(moonvolk_keybind) and moonvolk_eneble do
                    kakdela(UIS:IsKeyDown(moonvolk_keybind))                        --gavno kod master
                    local vremya = moonvolk_speed * (0.9 + math.random() * 0.1)     --gavno kod master
                    kakdela(UIS:IsKeyDown(moonvolk_keybind))                        --gavno kod master
                    VIM:SendKeyEvent(true, Enum.KeyCode.D, false, nil)              --gavno kod master
                    kakdela(UIS:IsKeyDown(moonvolk_keybind))                        --gavno kod master
                    task.wait(vremya)                                               --gavno kod master
                    kakdela(UIS:IsKeyDown(moonvolk_keybind))                        --gavno kod master
                    VIM:SendKeyEvent(false, Enum.KeyCode.D, false, nil)             --gavno kod master
                    kakdela(UIS:IsKeyDown(moonvolk_keybind))                        --gavno kod master
                    VIM:SendKeyEvent(true, Enum.KeyCode.A, false, nil)              --gavno kod master
                    kakdela(UIS:IsKeyDown(moonvolk_keybind))                        --gavno kod master
                    task.wait(vremya)                                               --gavno kod master
                    kakdela(UIS:IsKeyDown(moonvolk_keybind))                        --gavno kod master
                    VIM:SendKeyEvent(false, Enum.KeyCode.A, false, nil)             --gavno kod master
                    kakdela(UIS:IsKeyDown(moonvolk_keybind))                        --gavno kod master
                end
            end)
        end
    end)

    ril_nem.Destroying:Connect(function()
        moonvolk_eneble = false
    end)

end

local Tab = Window:NewTab("Settings UI")

local Section = Tab:NewSection("by DELIVERY")

Section:NewKeybind("Toggle UI", "open/close", Enum.KeyCode.N, function()
    Library:ToggleUI()
end)
