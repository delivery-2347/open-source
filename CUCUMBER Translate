local function TranslateText(text, fromLanguage, toLanguage)
    local HttpService = game:GetService("HttpService")

    local url =
        "https://translate.googleapis.com/translate_a/single?client=gtx"
        .. "&sl=" .. fromLanguage
        .. "&tl=" .. toLanguage
        .. "&dt=t"
        .. "&q=" .. HttpService:UrlEncode(text)

    local response = game:HttpGet(url)
    local data = HttpService:JSONDecode(response)

    if data[1] and data[1][1] and data[1][1][1] then
        return data[1][1][1]
    end

    return nil
end

TranslateButton.MouseButton1Click:Connect(function()

    if Input.Text == "" then
        Output.Text = "input is empty"
        return
    end

    Output.Text = "translating..."

    task.spawn(function()

        local success, result, errorMessage = pcall(function()

            return TranslateText(
                Input.Text,
                FROM_LANGUAGE,
                TO_LANGUAGE
            )

        end)

        if success then

            if result then
                Output.Text = result
            else
                Output.Text = errorMessage or "translation error"
            end

        else

            Output.Text = "error: " .. tostring(result)

        end

    end)
end)

--// Перетаскивание GUI
local function MakeDraggable(DragObject, MoveObject, onMove)
    local dragging = false
    local dragStart
    local startPosition
    local dragInput

    DragObject.Active = true

    DragObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = MoveObject.Position
            dragInput = input

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    DragObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then

            local delta = input.Position - dragStart

            MoveObject.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )

            if onMove then
                onMove()
            end
        end
    end)
end

