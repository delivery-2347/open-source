local function CreateDropdown(name, position, defaultText, callback)

    local Button = Instance.new("TextButton")
    Button.Name = name
    Button.Parent = Frame
    Button.BorderSizePixel = 0
    Button.TextSize = 14
    Button.TextColor3 = Color3.fromRGB(0, 255, 0)
    Button.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Button.FontFace = Font.new(
        "rbxasset://fonts/families/SourceSansPro.json",
        Enum.FontWeight.Regular,
        Enum.FontStyle.Normal
    )
    Button.Size = UDim2.new(0, 200, 0, 16)
    Button.Position = position
    Button.Text = defaultText

    local List = Instance.new("Frame")
    List.Name = "Dropdown"
    List.Parent = Frame
    List.Visible = false
    List.BorderSizePixel = 0
    List.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    List.Position = UDim2.new(
        position.X.Scale,
        position.X.Offset,
        position.Y.Scale,
        position.Y.Offset + 16
    )
    List.Size = UDim2.new(0, 200, 0, #Languages * 18)
    List.ZIndex = 20

    local Layout = Instance.new("UIListLayout")
    Layout.Parent = List
    Layout.SortOrder = Enum.SortOrder.LayoutOrder

    for _, language in ipairs(Languages) do

        local Option = Instance.new("TextButton")
        Option.Name = language[2]
        Option.Parent = List
        Option.BorderSizePixel = 0
        Option.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        Option.TextColor3 = Color3.fromRGB(0, 255, 0)
        Option.TextSize = 14
        Option.FontFace = Font.new(
            "rbxasset://fonts/families/SourceSansPro.json",
            Enum.FontWeight.Regular,
            Enum.FontStyle.Normal
        )
        Option.Size = UDim2.new(1, 0, 0, 18)
        Option.Text = language[1]
        Option.ZIndex = 21

        Option.MouseButton1Click:Connect(function()

            Button.Text = language[1]
            List.Visible = false

            callback(language[2], language[1])

        end)
    end

    Button.MouseButton1Click:Connect(function()
        List.Visible = not List.Visible
    end)

    return Button
end

