-- Local LuaEngine script.
-- Creates a half-size visual clone that follows and mirrors the local character.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local localPlayer = entity.get_local_player() or Players.LocalPlayer

local tab = menu.new_tab("Player Clone", "rbxassetid://10734975692")
local size_section = tab:new_section("Clone Size and Position", "Left")
local controls_section = tab:new_section("Clone Controls", "Left")
local motion_section = tab:new_section("Follow Motion", "Right")

local clone_scale_slider = size_section:new_slider("Clone scale", 0.1, 1, 0.5, 2, "x")
local follow_side_slider = size_section:new_slider("Side offset", -10, 10, 0, 2, " studs")
local follow_height_slider = size_section:new_slider("Height offset", -10, 10, -1.3, 2, " studs")
local follow_depth_slider = size_section:new_slider("Forward offset", -20, 0, -3, 2, " studs")

local spring_stiffness_slider = motion_section:new_slider("Spring stiffness", 1, 100, 50, 0)
local spring_damping_slider = motion_section:new_slider("Spring damping", 0, 20, 5, 1)
local rotation_smoothness_slider = motion_section:new_slider("Rotation smoothness", 0, 20, 6, 1)
local max_follow_speed_slider = motion_section:new_slider("Maximum follow speed", 1, 100, 32, 0, " studs/s")
local snap_distance_slider = motion_section:new_slider("Snap distance", 5, 200, 60, 0, " studs")

local cloneModel = nil
local sourceCharacter = nil
local sourceRootPart = nil
local cloneRootPart = nil
local partPairs = {}
local toolPartPairs = {}
local toolClones = {}
local sourceTools = {}
local sourceVisualSkin = nil
local cloneVisualSkin = nil
local sourceVisualWeapon = nil
local cloneVisualWeapon = nil
local visualWeaponPartPairs = {}
local cloneRootCFrame = nil
local cloneRootVelocity = Vector3.zero
local cloneScaleApplied = nil
local lastStartAttempt = 0
local inputConnection = nil

local function findCharacterRoot(character)
    if not character then
        return nil
    end

    for _, rootName in ipairs({ "Collide", "HumanoidRootPart", "Torso", "UpperTorso", "Root" }) do
        local root = character:FindFirstChild(rootName)
        if root and root:IsA("BasePart") then
            return root
        end
    end

    if character.PrimaryPart and character.PrimaryPart:IsA("BasePart") then
        return character.PrimaryPart
    end
    return nil
end

local function findLocalCharacter()
    local charactersFolder = Workspace:FindFirstChild("Characters")
    if charactersFolder and localPlayer then
        local gameCharacter = charactersFolder:FindFirstChild(localPlayer.Name)
        if gameCharacter and gameCharacter:IsA("Model") then
            return gameCharacter
        end
    end

    if localPlayer and localPlayer.Character then
        return localPlayer.Character
    end
    return nil
end

local function getBaseParts(model)
    local parts = {}
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            table.insert(parts, descendant)
        end
    end
    return parts
end

local function getCharacterBodyParts(model)
    local parts = {}
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            local ancestor = descendant.Parent
            local insideTool = false
            while ancestor and ancestor ~= model do
                if ancestor:IsA("Tool") then
                    insideTool = true
                    break
                end
                if ancestor.Name == "EquippedWeapon" then
                    insideTool = true
                    break
                end
                ancestor = ancestor.Parent
            end
            if not insideTool then
                table.insert(parts, descendant)
            end
        end
    end
    return parts
end

local function scaleClone(clone, sourceParts, cloneParts, scale)
    local scaledWithModelApi = pcall(function()
        clone:ScaleTo(scale)
    end)
    if scaledWithModelApi then
        return true
    end

    if #sourceParts ~= #cloneParts then
        return false
    end

    for index, clonePart in ipairs(cloneParts) do
        local sourcePart = sourceParts[index]
        clonePart.Size = sourcePart.Size * scale

        local sourceMeshes = {}
        for _, item in ipairs(sourcePart:GetChildren()) do
            if item:IsA("DataModelMesh") then
                table.insert(sourceMeshes, item)
            end
        end

        local cloneMeshIndex = 0
        for _, item in ipairs(clonePart:GetChildren()) do
            if item:IsA("DataModelMesh") then
                cloneMeshIndex += 1
                local sourceMesh = sourceMeshes[cloneMeshIndex]
                if sourceMesh then
                    item.Scale = sourceMesh.Scale * scale
                end
            elseif item:IsA("Attachment") then
                local sourceAttachment = sourcePart:FindFirstChild(item.Name)
                if sourceAttachment and sourceAttachment:IsA("Attachment") then
                    item.Position = sourceAttachment.Position * scale
                end
            end
        end
    end
    return true
end

local function getEquippedTools(character)
    local tools = {}
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            table.insert(tools, child)
        end
    end
    return tools
end

local function toolListsMatch(left, right)
    if #left ~= #right then
        return false
    end
    for index, tool in ipairs(left) do
        if tool ~= right[index] then
            return false
        end
    end
    return true
end

local function setPartsForClone(parts)
    for _, part in ipairs(parts) do
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.Massless = true
    end
end

local function cloneEquippedTool(sourceTool, scale)
    local archivableStates = {}
    local function setArchivable(instance)
        table.insert(archivableStates, { instance = instance, value = instance.Archivable })
        instance.Archivable = true
    end

    setArchivable(sourceTool)
    for _, descendant in ipairs(sourceTool:GetDescendants()) do
        setArchivable(descendant)
    end
    local cloneOk, toolClone = pcall(function()
        return sourceTool:Clone()
    end)
    for index = #archivableStates, 1, -1 do
        local saved = archivableStates[index]
        saved.instance.Archivable = saved.value
    end
    if not cloneOk or not toolClone then
        return nil
    end

    for _, descendant in ipairs(toolClone:GetDescendants()) do
        if descendant:IsA("Script") or descendant:IsA("LocalScript") then
            descendant:Destroy()
        end
    end

    local sourceParts = getBaseParts(sourceTool)
    local cloneParts = getBaseParts(toolClone)
    if #sourceParts ~= #cloneParts or not scaleClone(toolClone, sourceParts, cloneParts, scale) then
        toolClone:Destroy()
        return nil
    end

    toolClone.Parent = cloneModel
    setPartsForClone(cloneParts)
    return toolClone, sourceParts, cloneParts
end

local function makeVisualWeaponClone(sourceWeapon, scale)
    local archivableStates = {}
    local function setArchivable(instance)
        table.insert(archivableStates, { instance = instance, value = instance.Archivable })
        instance.Archivable = true
    end

    setArchivable(sourceWeapon)
    for _, descendant in ipairs(sourceWeapon:GetDescendants()) do
        setArchivable(descendant)
    end
    local cloneOk, weaponClone = pcall(function()
        return sourceWeapon:Clone()
    end)
    for index = #archivableStates, 1, -1 do
        local saved = archivableStates[index]
        saved.instance.Archivable = saved.value
    end
    if not cloneOk or not weaponClone then
        return nil
    end

    weaponClone.Name = "EquippedWeapon"
    for _, descendant in ipairs(weaponClone:GetDescendants()) do
        if descendant:IsA("Script") or descendant:IsA("LocalScript") then
            descendant:Destroy()
        end
    end

    local sourceParts = getBaseParts(sourceWeapon)
    local cloneParts = getBaseParts(weaponClone)
    if #sourceParts ~= #cloneParts or not scaleClone(weaponClone, sourceParts, cloneParts, scale) then
        weaponClone:Destroy()
        return nil
    end

    weaponClone.Parent = cloneVisualSkin
    setPartsForClone(cloneParts)
    return weaponClone, sourceParts, cloneParts
end

local function syncVisualWeapon()
    if not sourceVisualSkin or not cloneVisualSkin then
        return false
    end

    local currentWeapon = sourceVisualSkin:FindFirstChild("EquippedWeapon")
    local cloneIsValid = currentWeapon == nil
        and cloneVisualWeapon == nil
        or currentWeapon ~= nil
        and cloneVisualWeapon ~= nil
        and cloneVisualWeapon.Parent == cloneVisualSkin
    if currentWeapon == sourceVisualWeapon and cloneIsValid then
        return false
    end

    if cloneVisualWeapon and cloneVisualWeapon.Parent then
        cloneVisualWeapon:Destroy()
    end
    cloneVisualWeapon = nil
    visualWeaponPartPairs = {}

    for _, child in ipairs(cloneVisualSkin:GetChildren()) do
        if child.Name == "EquippedWeapon" then
            child:Destroy()
        end
    end

    sourceVisualWeapon = currentWeapon
    if not currentWeapon then
        return true
    end

    local weaponClone, sourceParts, cloneParts = makeVisualWeaponClone(currentWeapon, clone_scale_slider:get())
    if not weaponClone then
        sourceVisualWeapon = nil
        return true
    end

    cloneVisualWeapon = weaponClone
    for index, sourcePart in ipairs(sourceParts) do
        table.insert(visualWeaponPartPairs, { source = sourcePart, clone = cloneParts[index] })
    end
    return true
end

local function syncEquippedTools()
    if not sourceCharacter or not cloneModel then
        return false
    end

    local currentTools = getEquippedTools(sourceCharacter)
    if toolListsMatch(currentTools, sourceTools) then
        return false
    end

    for _, toolPair in ipairs(toolClones) do
        if toolPair.clone and toolPair.clone.Parent then
            toolPair.clone:Destroy()
        end
    end
    toolClones = {}
    toolPartPairs = {}

    local scale = clone_scale_slider:get()
    local allCloned = true
    for _, sourceTool in ipairs(currentTools) do
        local cloneTool, sourceParts, cloneParts = cloneEquippedTool(sourceTool, scale)
        if cloneTool then
            table.insert(toolClones, { source = sourceTool, clone = cloneTool })
            for index, sourcePart in ipairs(sourceParts) do
                table.insert(toolPartPairs, { source = sourcePart, clone = cloneParts[index] })
            end
        else
            allCloned = false
        end
    end
    sourceTools = allCloned and currentTools or {}
    return true
end

local function rescaleClone(scale)
    local sourceParts = getCharacterBodyParts(sourceCharacter)
    local cloneParts = getCharacterBodyParts(cloneModel)
    if #sourceParts ~= #cloneParts or not scaleClone(cloneModel, sourceParts, cloneParts, scale) then
        return false
    end

    partPairs = {}
    setPartsForClone(cloneParts)
    for index, sourcePart in ipairs(sourceParts) do
        table.insert(partPairs, { source = sourcePart, clone = cloneParts[index] })
    end

    toolPartPairs = {}
    for _, toolPair in ipairs(toolClones) do
        local sourceToolParts = getBaseParts(toolPair.source)
        local cloneToolParts = getBaseParts(toolPair.clone)
        if #sourceToolParts ~= #cloneToolParts or not scaleClone(toolPair.clone, sourceToolParts, cloneToolParts, scale) then
            return false
        end
        setPartsForClone(cloneToolParts)
        for index, sourcePart in ipairs(sourceToolParts) do
            table.insert(toolPartPairs, { source = sourcePart, clone = cloneToolParts[index] })
        end
    end

    visualWeaponPartPairs = {}
    if sourceVisualWeapon and cloneVisualWeapon then
        local sourceWeaponParts = getBaseParts(sourceVisualWeapon)
        local cloneWeaponParts = getBaseParts(cloneVisualWeapon)
        if #sourceWeaponParts ~= #cloneWeaponParts
            or not scaleClone(cloneVisualWeapon, sourceWeaponParts, cloneWeaponParts, scale) then
            return false
        end
        setPartsForClone(cloneWeaponParts)
        for index, sourcePart in ipairs(sourceWeaponParts) do
            table.insert(visualWeaponPartPairs, { source = sourcePart, clone = cloneWeaponParts[index] })
        end
    end

    cloneScaleApplied = scale
    return true
end

local function destroyClone()
    if cloneModel then
        pcall(function()
            cloneModel:Destroy()
        end)
        cloneModel = nil
    end

    sourceCharacter = nil
    sourceRootPart = nil
    cloneRootPart = nil
    partPairs = {}
    toolPartPairs = {}
    toolClones = {}
    sourceTools = {}
    sourceVisualSkin = nil
    cloneVisualSkin = nil
    sourceVisualWeapon = nil
    cloneVisualWeapon = nil
    visualWeaponPartPairs = {}
    cloneRootCFrame = nil
    cloneRootVelocity = Vector3.zero
    cloneScaleApplied = nil
end

local function makeClone(character)
    local rootPart = findCharacterRoot(character)
    if not rootPart or not localPlayer then
        return nil
    end

    local wasArchivable = character.Archivable
    local sourceToolToClone = character:FindFirstChildOfClass("Tool")
    local wasToolArchivable = sourceToolToClone and sourceToolToClone.Archivable
    character.Archivable = true
    if sourceToolToClone then
        sourceToolToClone.Archivable = true
    end
    local cloneSucceeded, clone = pcall(function()
        return character:Clone()
    end)
    character.Archivable = wasArchivable
    if sourceToolToClone then
        sourceToolToClone.Archivable = wasToolArchivable
    end
    if not cloneSucceeded or not clone then
        return nil
    end

    clone.Name = localPlayer.Name .. "_HalfSizeClone"
    for _, child in ipairs(clone:GetChildren()) do
        if child:IsA("Tool") then
            child:Destroy()
        end
    end

    local sourceParts = getCharacterBodyParts(character)
    local cloneParts = getCharacterBodyParts(clone)
    if #sourceParts == 0 or #sourceParts ~= #cloneParts then
        clone:Destroy()
        return nil
    end

    local scale = clone_scale_slider:get()
    if not scaleClone(clone, sourceParts, cloneParts, scale) then
        clone:Destroy()
        return nil
    end

    partPairs = {}
    setPartsForClone(cloneParts)
    for index, sourcePart in ipairs(sourceParts) do
        local clonePart = cloneParts[index]
        table.insert(partPairs, { source = sourcePart, clone = clonePart })
    end

    for _, descendant in ipairs(clone:GetDescendants()) do
        if descendant:IsA("Script") or descendant:IsA("LocalScript") then
            descendant:Destroy()
        end
    end

    local cloneRoot = findCharacterRoot(clone)
    if not cloneRoot then
        clone:Destroy()
        return nil
    end

    clone.Parent = Workspace
    cloneModel = clone
    sourceCharacter = character
    sourceRootPart = rootPart
    cloneRootPart = cloneRoot
    cloneScaleApplied = scale
    sourceVisualSkin = character:FindFirstChild("VisualSkin")
    cloneVisualSkin = clone:FindFirstChild("VisualSkin")
    sourceVisualWeapon = nil
    cloneVisualWeapon = nil
    visualWeaponPartPairs = {}
    syncEquippedTools()
    syncVisualWeapon()

    local targetRootCFrame = rootPart.CFrame * CFrame.new(
        follow_side_slider:get(),
        follow_height_slider:get(),
        follow_depth_slider:get()
    )
    cloneRootCFrame = targetRootCFrame
    cloneRootVelocity = Vector3.zero
    return clone
end

local function startFollowing(character, forceRecreate)
    if not character then
        return false
    end
    if not forceRecreate and character == sourceCharacter and cloneModel then
        return true
    end

    destroyClone()
    return makeClone(character) ~= nil
end

local function updateClone(deltaTime)
    local character = findLocalCharacter()
    if not character then
        if sourceCharacter then
            destroyClone()
        end
        return
    end

    if character ~= sourceCharacter or not cloneModel then
        local now = tick()
        if now - lastStartAttempt >= 0.25 then
            lastStartAttempt = now
            startFollowing(character, true)
        end
        return
    end

    -- Replace only the clone's tools when the character equips or removes one.
    syncEquippedTools()
    syncVisualWeapon()

    local scale = clone_scale_slider:get()
    if not cloneScaleApplied or math.abs(scale - cloneScaleApplied) > 0.001 then
        if not rescaleClone(scale) then
            destroyClone()
            return
        end
    end

    if not cloneModel.Parent or not sourceRootPart or not sourceRootPart.Parent
        or not cloneRootPart or not cloneRootPart.Parent then
        destroyClone()
        return
    end

    local desiredRootCFrame = sourceRootPart.CFrame * CFrame.new(
        follow_side_slider:get(),
        follow_height_slider:get(),
        follow_depth_slider:get()
    )
    local desiredPosition = desiredRootCFrame.Position
    local currentPosition = cloneRootCFrame.Position
    local distance = (desiredPosition - currentPosition).Magnitude
    local step = math.clamp(tonumber(deltaTime) or (1 / 60), 0, 0.05)

    if distance > snap_distance_slider:get() then
        currentPosition = desiredPosition
        cloneRootVelocity = Vector3.zero
    else
        local acceleration = (desiredPosition - currentPosition) * spring_stiffness_slider:get()
            - cloneRootVelocity * spring_damping_slider:get()
        cloneRootVelocity += acceleration * step

        local maxSpeed = max_follow_speed_slider:get()
        if cloneRootVelocity.Magnitude > maxSpeed then
            cloneRootVelocity = cloneRootVelocity.Unit * maxSpeed
        end
        currentPosition += cloneRootVelocity * step
    end

    local currentRotation = cloneRootCFrame - cloneRootCFrame.Position
    local desiredRotation = desiredRootCFrame - desiredRootCFrame.Position
    local rotationBlend = math.clamp(step * rotation_smoothness_slider:get(), 0, 1)
    local smoothedRotation = currentRotation:Lerp(desiredRotation, rotationBlend)
    cloneRootCFrame = CFrame.new(currentPosition) * smoothedRotation

    local currentSourceRootCFrame = sourceRootPart.CFrame
    for _, pair in ipairs(partPairs) do
        if pair.source.Parent and pair.clone.Parent then
            pair.clone.Anchored = true
            pair.clone.CanCollide = false
            pair.clone.CanTouch = false
            pair.clone.CanQuery = false
            local sourceRelativeCFrame = currentSourceRootCFrame:ToObjectSpace(pair.source.CFrame)
            local scaledOffset = sourceRelativeCFrame.Position * scale
            local relativeRotation = sourceRelativeCFrame - sourceRelativeCFrame.Position
            pair.clone.CFrame = cloneRootCFrame * CFrame.new(scaledOffset) * relativeRotation
        end
    end

    for _, pair in ipairs(toolPartPairs) do
        if pair.source.Parent and pair.clone.Parent then
            pair.clone.Anchored = true
            pair.clone.CanCollide = false
            pair.clone.CanTouch = false
            pair.clone.CanQuery = false
            local sourceRelativeCFrame = currentSourceRootCFrame:ToObjectSpace(pair.source.CFrame)
            local scaledOffset = sourceRelativeCFrame.Position * scale
            local relativeRotation = sourceRelativeCFrame - sourceRelativeCFrame.Position
            pair.clone.CFrame = cloneRootCFrame * CFrame.new(scaledOffset) * relativeRotation
        end
    end

    for _, pair in ipairs(visualWeaponPartPairs) do
        if pair.source.Parent and pair.clone.Parent then
            pair.clone.Anchored = true
            pair.clone.CanCollide = false
            pair.clone.CanTouch = false
            pair.clone.CanQuery = false
            local sourceRelativeCFrame = currentSourceRootCFrame:ToObjectSpace(pair.source.CFrame)
            local scaledOffset = sourceRelativeCFrame.Position * scale
            local relativeRotation = sourceRelativeCFrame - sourceRelativeCFrame.Position
            pair.clone.CFrame = cloneRootCFrame * CFrame.new(scaledOffset) * relativeRotation
        end
    end
end

local reloadConfirmationGui

local function closeReloadConfirmation()
    if reloadConfirmationGui then
        pcall(function()
            reloadConfirmationGui:Destroy()
        end)
        reloadConfirmationGui = nil
    end
end

local function resetCloneSliders()
    clone_scale_slider:set(0.5, true)
    follow_side_slider:set(0, true)
    follow_height_slider:set(-1.3, true)
    follow_depth_slider:set(-3, true)
    spring_stiffness_slider:set(50, true)
    spring_damping_slider:set(5, true)
    rotation_smoothness_slider:set(6, true)
    max_follow_speed_slider:set(32, true)
    snap_distance_slider:set(60, true)
end

