end

controls_section:new_button("Reload clone", showReloadConfirmation)

inputConnection = UserInputService.InputBegan:Connect(function()
    task.spawn(function()
        task.wait(0.05)
        if sourceCharacter and cloneModel then
            syncEquippedTools()
            syncVisualWeapon()
        end
    end)
end)

client.set_event_callback("paint", updateClone)
client.set_event_callback("shutdown", function()
    closeReloadConfirmation()
    if inputConnection then
        inputConnection:Disconnect()
        inputConnection = nil
    end
    destroyClone()
end)
