--==================================================
-- GUI PARENT + PRIORITY
--==================================================

local function GetGuiParent()
	if UseCoreGui then
		return CoreGui
	else
		return LocalPlayer:WaitForChild("PlayerGui")
	end
end

local function UpdateGuiLocation()
	ScreenGui.Parent = GetGuiParent()

	if UseCoreGui then
		-- CoreGui = поверх
		ScreenGui.DisplayOrder = 999999
	else
		-- PlayerGui = низкий приоритет
		ScreenGui.DisplayOrder = -100
	end
end

