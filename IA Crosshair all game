--==================================================
-- DEFAULT CURSOR
--==================================================

local eneiblekursos = false

local function SetDefaultCursor()
	local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
	local Crosshairs = PlayerGui:FindFirstChild("Crosshairs")

	if Crosshairs then
		Crosshairs.Enabled = not eneiblekursos
	end
end

