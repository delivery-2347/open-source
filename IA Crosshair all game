--==================================================
-- MOUSE INPUT
--==================================================

UserInputService.InputChanged:Connect(function(Input)

	if Input.UserInputType ~= Enum.UserInputType.MouseMovement then
		return
	end

	if SizeDragging then
		UpdateSize(Input.Position.X)
	end

	if SpeedDragging then
		UpdateSpeed(Input.Position.X)
	end

	if Dragging then

		local Delta = Input.Position - DragStart

		Main.Position = UDim2.new(
			StartPosition.X.Scale,
			StartPosition.X.Offset + Delta.X,

			StartPosition.Y.Scale,
			StartPosition.Y.Offset + Delta.Y
		)

	end

end)

UserInputService.InputEnded:Connect(function(Input)

	if Input.UserInputType == Enum.UserInputType.MouseButton1 then

		SizeDragging = false
		SpeedDragging = false
		Dragging = false

	end

end)

--==================================================
-- KEYBINDS
--==================================================

UserInputService.InputBegan:Connect(function(Input, GameProcessed)

	if UserInputService:GetFocusedTextBox() then
		return
	end

	-- Changing bind
	if WaitingForBind then

		if Input.UserInputType == Enum.UserInputType.Keyboard then

			ToggleKey = Input.KeyCode
			WaitingForBind = false

			BindButton.Text =
				"Bind: " .. ToggleKey.Name

		end

		return
	end

	if GameProcessed then
		return
	end

	-- Toggle crosshair
	if Input.KeyCode == ToggleKey then

		CrosshairEnabled = not CrosshairEnabled

		Crosshair.Visible = CrosshairEnabled

		ToggleButton.Text =
			"Crosshair: " ..
			(CrosshairEnabled and "ON" or "OFF")

	end

end)

--==================================================
-- CROSSHAIR LOOP
--==================================================

RunService.RenderStepped:Connect(function(DeltaTime)

	UpdateCrosshairPosition()

	if RotationSpeed <= 0 then

		Rotation = 0
		Crosshair.Rotation = 0

	else

		Rotation += RotationSpeed * 12 * DeltaTime
		Crosshair.Rotation = Rotation % 360

	end

end)
