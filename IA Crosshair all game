local function UpdateSize(MouseX)
	local Alpha = math.clamp(
		(MouseX - SizeBar.AbsolutePosition.X)
			/ SizeBar.AbsoluteSize.X,
		0,
		1
	)

	CrosshairSize = math.floor(
		10 + Alpha * 190
	)

	Crosshair.Size = UDim2.fromOffset(
		CrosshairSize,
		CrosshairSize
	)

	SizeLabel.Text = "Size: " .. CrosshairSize

	SizeFill.Size = UDim2.new(
		Alpha,
		0,
		1,
		0
	)

	SizeKnob.Position = UDim2.new(
		Alpha,
		0,
		0.5,
		0
	)
end

